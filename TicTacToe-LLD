class Board
{
    private:
        vector<vector<char>>boardState ;
        
    public:
        Board(int boardSize)
        {
            boardState = vector<vector<char>>(boardSize,vector<char>(' ',boardSize)) ;
        }
        void printBoard()
        {
            for(int i=0 ; i<boardState.size() ; i++)
            {
                for(int j=0 ; j<boardState.size() ; j++)
                {
                    cout<<boardState[i][j]<<" " ;
                }
                cout<<endl ;
                
            }
        }
        void makeMove(int row, int col, char ch)
        {
            // TO-DO pre-checks
            boardState[row][col] = ch ;
        }
    
};


