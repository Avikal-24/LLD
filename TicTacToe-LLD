class Player
{
    private:
        char symbol ;
        IPlayerStrategy* strategy = nullptr ;
        Player() = default ;
    
    public:
        
        Player(char symbol)
        {
            this->symbol = symbol ;
        }
        void setStrategy(IPlayerStrategy* strategy)
        {
            this->strategy = strategy ;
        }
        void makeMove()
        {
            strategy->makeMove(symbol) ;
        }
        
};

class PlayerFactory
{
    private:
        unordered_set<char>usedSymbols ;
    public:
        PlayerFactory() = default ;
        Player* createPlayer(char symbol)
        {
            if(usedSymbols.find(symbol) != usedSymbols.end()) return nullptr ;
            usedSymbols.insert(symbol) ; 
            Player* newPlayer= new Player(symbol) ; 
            return newPlayer ;
        }
};


class GameRoom
{
    private:
        Board* board ;
        inline static PlayerFactory *playerFactory = new PlayerFactory();
        vector<Player*>players ;
        int currPlayerIdx = 0 ;
   
    public:
        GameRoom(int boardSize, int numPlayers)
        {
            board= new Board(boardSize) ;
            for(int i=0 ; i<numPlayers ; i++)
            {
                char ch ;
                cin>> ch ; 
                Player *newPlayer = playerFactory->createPlayer(ch) ;
                players.push_back(newPlayer) ;
            }
        }
   
} ;

