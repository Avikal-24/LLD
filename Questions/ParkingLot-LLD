        unordered_set<ParkingSlot*>freeSlots ;
        unordered_set<ParkingSlot*>busySlots ;
        
        unordered_map<IVehicle*,ParkingSlot*>vehicleSlotMap ;
        
        IBillCalculationStrategy* billCalculationStrategy = nullptr ;
        
        vector<Observer*>observers ;
    
    public:
        ParkingFacade()
        {
            billCalculationStrategy = new WeekdayBillPaymentStrategy() ;
        }
        void addObserver(Observer* observer) override
        {
            observers.push_back(observer) ;
        }
        void removeObserver(Observer* observer) override
        {
            //
        }
        void notifyObservers(string str)
        {
            for(auto observer:observers)
            {
                observer->notify(str) ;
            }
        }
        void addFreeSlot(VehicleSize size)
        {
            freeSlots.insert( new ParkingSlot(size) ) ;
        }
        void enterVehicle(IVehicle* vehicle)
        {
            VehicleSize currVehicleSize = vehicle->getSize() ;
            ParkingSlot* parkSlot = findFreeSlot(currVehicleSize) ;
            
            freeSlots.erase(parkSlot) ; 
            busySlots.insert(parkSlot) ;
            
            vehicle->park() ;
            
            vehicleSlotMap[vehicle] = parkSlot ;
        }
        void exitVehicle(IVehicle* vehicle)
        {
            ParkingSlot* parkSlot = vehicleSlotMap[vehicle] ;
            
            vehicle->unpark() ;
            
            freeSlots.insert(parkSlot) ; 
            busySlots.erase(parkSlot) ;
            
            vehicleSlotMap.erase(vehicle);
            
            int bill = calculateBill(vehicle) ;
            
            paybill(bill,vehicle) ;
        }
        int calculateBill(IVehicle* vehicle)
        {
            return billCalculationStrategy->calculateBill(5) ; // assuming 5 hrs
        }
        void changeBillCalculationStrategy(IBillCalculationStrategy* newStrategy )
        {
            billCalculationStrategy = newStrategy ;
            notifyObservers("Strategy has been changed") ;
