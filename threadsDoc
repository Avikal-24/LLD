18. Futures

 std::async 

auto future = std::async(std::launch::async, [] {
    std::this_thread::sleep_for(std::chrono::seconds(1));
    return 42;
});

std::cout << future.get() << '\n';

Check completion

using namespace std::chrono_literals;

if (future.wait_for(0ms) == std::future_status::ready) {
    std::cout << "Ready\n";
}

Timeout

if (future.wait_for(std::chrono::seconds(2))
        == std::future_status::ready) {
    std::cout << future.get();
} else {
    std::cout << "Timed out\n";
}

A timeout does not cancel the underlying computation.

 std::packaged_task 

This separates task creation from thread execution:

std::packaged_task<int()> task([] {
    return 10 + 20;
});

std::future<int> result = task.get_future();
std::thread worker(std::move(task));

std::cout << result.get() << '\n';
worker.join();

 std::promise 

Use a promise when code manually produces a result:

std::promise<std::string> promise;
std::future<std::string> future = promise.get_future();

std::thread producer([promise = std::move(promise)]() mutable {
    promise.set_value("Completed");
});

std::cout << future.get() << '\n';
producer.join();

Use  set_exception()  to propagate failure.

Shared future

A normal  std::future  supports only one  get() . Use  std::shared_future  when multiple consumers need the result:

std::shared_future<int> result =
    std::async(std::launch::async, [] { return 42; }).share();

