#include <bits/stdc++.h>
using namespace std ;

// to make a thread sleep
// shared lock and unique lock
// shared mutex

class Bus
{
    private:
        vector<int>seats ;
        shared_mutex mu ;
        
    public:
        Bus() = default ;
        void showSeats()
        {
            shared_lock<shared_mutex>sharedLock(mu) ;
            
            for(auto it: seats) cout<<it<<" " ;
        }
        void bookSeat(int x)
        {
            unique_lock<shared_mutex>uniqueLock(mu) ;
            seats.push_back(x) ;

            // making a thread sleep
            this_thread::sleep_for(chrono::microseconds(1000) ) ;
        }
};


// thread declaration
// to get thread ID
int main()
{
    Bus* myBus = new Bus() ;
    
    // SYNTAX 
    thread t2(&Bus::bookSeat,myBus,3) ;
    thread t1(&Bus::showSeats,myBus) ;


    // to get thread's ID
    cout<<this_thread::get_id()<<endl ;

    t1.join() ; 
    t2.join() ;
    
    return 0;
}
