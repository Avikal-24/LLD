    public:
        ParkingFacade()
        {
            billCalculationStrategy = new WeekdayBillPaymentStrategy() ;
        }
        void addFreeSlot(VehicleSize size)
        {
            freeSlots.insert( new ParkingSlot(size) ) ;
        }
        void enterVehicle(IVehicle* vehicle)
        {
            VehicleSize currVehicleSize = vehicle->getSize() ;
            ParkingSlot* parkSlot = findFreeSlot(currVehicleSize) ;
            
            freeSlots.erase(parkSlot) ; 
            busySlots.insert(parkSlot) ;
            
            vehicle->park() ;
            
            vehicleSlotMap[vehicle] = parkSlot ;
        }
        void exitVehicle(IVehicle* vehicle)
        {
            ParkingSlot* parkSlot = vehicleSlotMap[vehicle] ;
            
            vehicle->unpark() ;
            
            freeSlots.insert(parkSlot) ; 
