class VendingMachine
{
    private:
        PaymentProcessor *paymentProcessor = nullptr;
        
        State* paymentState ;
        State* selectionState;
        State* dispenseState;
        State* currentState = nullptr ;
        
        unordered_map<string,VendingMachineSlot*>slotMap ;
        
        int bill = 0 ;
        VendingMachineSlot* selectedSlot = nullptr ; 
        
    public:
        VendingMachine()
        {
            paymentProcessor = new PaymentProcessor() ;
            paymentState = new PaymentState(this) ;
            dispenseState = new DispenseState(this) ;
            selectionState = new SelectionState(this) ;
            
            selectionState->SetNextState(paymentState) ; 
            paymentState->SetNextState(dispenseState) ;
            dispenseState->SetNextState(selectionState) ;
            
            
            currentState = selectionState ;
        }
        void addSlot(VendingMachineSlot* slot)
        {
            slotMap[slot->getSlotId()] = slot ;
        }
        
        void executeCurrentState()
        {
            currentState->execute() ;
        }
        State* getState()
        {
            return currentState ;
        }
        void changeState(State* newState)
        {
            currentState = newState ;
        }
        
        void generateBill(string slotName)
        {
            selectedSlot= slotMap[slotName] ;
            Product* product = selectedSlot->getProduct() ;
            bill = product->getCost() ;
        }
        int getBill()
        {
            return bill ;
        }
        PaymentProcessor* getPaymentProcessor()
        {
            return paymentProcessor ;
        }
        
        
        void setSelectedSlot(VendingMachineSlot* slot)
        {
            selectedSlot = slot ;
        }
        VendingMachineSlot* getSelectedSlot()
        {
            return selectedSlot ;
        }
};

