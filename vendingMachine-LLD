class MoneyDispenser
{
    public: 
        virtual void dispense(int amt) = 0 ;  
        virtual void setNextDispenser(MoneyDispenser* next) = 0 ;
};

class ThousandMoneyDispenser : public MoneyDispenser
{
    private:
        int denomination=1000 ;
        MoneyDispenser* nextDispenser ;
        
    public:
        ThousandMoneyDispenser() = default ;
        void dispense(int amt) override
        {
            if(amt>=denomination)
            {
                cout<<"dispensing the amount:"<<amt/denomination<<endl ;
            }
            amt%=denomination ;
            if(amt>0 && nextDispenser != nullptr )
            {
                nextDispenser->dispense(amt) ;
            }
        }
        void setNextDispenser(MoneyDispenser* next) override
        {
            nextDispenser = next;
        }
};

class OneMoneyDispenser : public MoneyDispenser
{
    private:
        int denomination=1 ;
        MoneyDispenser* nextDispenser ;
        
    public:
        OneMoneyDispenser() = default ;
        void dispense(int amt) override
        {
            cout<<"dispensing the remaining amt" ;
        }
        void setNextDispenser(MoneyDispenser* next) override
        {
            nextDispenser = next;
        }
};

class BalancePaymentFetcher
{
    private:
        MoneyDispenser* thousandMoneyDispenser ;
        MoneyDispenser* oneMoneyDispenser ;
        
    public:
        BalancePaymentFetcher()
        {
            thousandMoneyDispenser = new ThousandMoneyDispenser() ;
            oneMoneyDispenser = new OneMoneyDispenser() ;
            
            thousandMoneyDispenser->setNextDispenser(oneMoneyDispenser) ;
        }
        void fetch(int amt)
        {
            thousandMoneyDispenser->dispense(amt) ;
        }
};

