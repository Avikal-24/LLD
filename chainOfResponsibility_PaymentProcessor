class Tray;

class Tray
{
    private:
        Tray* nextTray = nullptr ;
        
    public:
    virtual void transact(int money) = 0 ;
    
    void setNext(Tray* nextTray)
    {
        this->nextTray = nextTray ;
    }
};

class ThousandTray : public Tray
{
    private:
        Tray* nextTray = nullptr ;
        
    public:
    ThousandTray(Tray* nextTray)
    {
        this->nextTray = nextTray ;
    }
    void transact(int money) override
    {
        if(money == 0)
        {
            cout<<"transaction alreadt completed\n" ;
            return ;
        }
        if(money >= 1000)
        {
            int processMoney= money/1000 * 1000 ; 
            cout<<processMoney<<" is dispatching";
            money -= processMoney ;
        }
        if(money > 0)
        {
            if(nextTray != nullptr)
            {
                nextTray->transact(money) ;
            }
            else
            {
                cout<<money<<" is lost!!!" ;
            }
        }
    }

};
